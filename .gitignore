# ==================================
# 1. Conda/Python 环境和缓存
# ==================================

# 忽略所有 Python 缓存文件和目录
__pycache__/
*.pyc

# 忽略 Conda/虚拟环境目录
# (你当前的 `yx` 环境在 /data/miniconda3/envs/yx/ 下，但最好也排除项目内的 env)
/env/
/venv/
.conda/
.pip-cache/

# ==================================
# 2. 昇腾 (Ascend) NPU 特有文件
# ==================================

# 忽略所有 .whl 安装包 (你已经下载的 torch-npu 等)
*.whl

# 忽略 CANN/昇腾运行时可能生成的日志或文件
/ascend_log/
/cann_log/

# ==================================
# 3. 模型权重和训练输出 (通常很大，不适合 Git)
# ==================================

# 忽略常见的模型权重文件
*.pt
*.pth
*.pth.tar
*.ckpt
*.h5

**/out_bin/UVG/
**/*.bin
**/*.yuv
/my_datasets/
/temp_test_dataset/
/temp_test_dataset_yuv420p/

# 忽略训练日志和 TensorBoard 文件
/logs/
/runs/
/results/

# 忽略大型数据集 (如果你的数据存放在项目目录下)
/data/

# ==================================
# 4. IDE 和操作系统文件
# ==================================

# 忽略 macOS 操作系统文件
.DS_Store

# 忽略 IDE (如 PyCharm, VS Code) 的配置文件
.idea/
.vscode

